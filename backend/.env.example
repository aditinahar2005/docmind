# Groq is the default: free tier, no credit card. https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI alternative (requires prepaid API credits, separate from ChatGPT Plus):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# Open demo (default): no login required. Google Sign-In is optional.
DEMO_MODE=true
GOOGLE_CLIENT_ID=
AUTH_SECRET=

# Comma-separated extra origins for when the UI is on a different host than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
